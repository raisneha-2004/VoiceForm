# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/voiceform

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production_voiceform_2026_xyz
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_voiceform_2026_abc
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider Configuration ('gemini' | 'openai' | 'mock')
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=10
VOICE_RATE_LIMIT_MAX=60
